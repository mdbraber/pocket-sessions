        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Report to PCS",
      "credentials": {
        "httpHeaderAuth": {
          "id": "pcs-operator-token",
          "name": "PCS operator token"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "OwnTube event": {
      "main": [
        [
          {
            "node": "Report to PCS",
            "type": "main",
            "index": 0
          }
        ]
