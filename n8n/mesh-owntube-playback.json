{
  "id": "meshOwntubePlay01",
  "name": "Mesh: OwnTube playback \u2192 PCS",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "owntube-playback",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "OwnTube event",
      "webhookId": "a1000000-0000-4000-8000-000000000001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "mesh-webhook-token",
          "name": "Mesh webhook token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://pocket-sessions:8080/api/v1/playback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
